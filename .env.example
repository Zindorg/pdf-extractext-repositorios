# ---- Release (factor V) ----
# Versión de la imagen a construir/desplegar (obligatoria). No reutilizar tags.
VERSIONREP=1.1.2
# Registry opcional, debe terminar en "/" (ej: registry.tuorg/). Vacío = imagen local.
REGISTRY=

# ---- Persister ----
TZ=America/Argentina/Mendoza
HTTP_PORT=8083
# Cantidad de réplicas del persister (factor VI: procesos sin estado)
PERSISTER_REPLICAS=2
# Host del router de Traefik
PERSISTER_HOST=persister.internal

# ---- MongoDB ----
MONGODB_DATABASE=text_extractor_d
# ---- REDIS   -----
REDIS_USERNAME=
REDIS_PASSWORD=
# true => conexión TLS a Redis (necesario en Redis gestionado/remoto)
REDIS_TLS=false
STREAM_NAME=document-events
STREAM_GROUP=documents-persister
DLQ_NAME=document-events-dlq
# CONSUMER_NAME no se define: por defecto es hostname-pid, único por réplica.
# CONSUMER_NAME=

# ---- Retry ----
RETRY_MAX=5
RETRY_BACKOFF=5s

# ---- Límites ----
MAX_TEXT_BYTES=15728640

# ---- Rate limit ----
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ---- Circuit breaker ----
CB_FAILURES=5
CB_TIMEOUT=30s

# ---- Caché ----
CACHE_TTL=60s

# ---- Logging ----
LOG_LEVEL=info
GIN_MODE=release
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ---- Consul (registro opcional) ----
# Si no se define, el compose usa http://consul:8500. Para desactivar el registro: CONSUL_HTTP_ADDR= (vacía).
# CONSUL_HTTP_ADDR=http://consul:8500
# Secreto: su valor real va solo en el .env local, nunca versionado.
CONSUL_HTTP_TOKEN=
SERVICE_ADDRESS=persister

# ---- Validación ----
# true => la app no arranca si faltan MONGODB_URI o REDIS_ADDR (recomendado en producción)
CONFIG_STRICT=false