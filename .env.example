# ---- Persister ----
HTTP_PORT=8083

# ---- MongoDB ----
MONGODB_DATABASE=text_extractor_db
MONGODB_URI=mongodb://localhost:27017/text_extractor_db

# ---- Redis ----
REDIS_ADDR=localhost:6379
STREAM_NAME=document-events
STREAM_GROUP=documents-persister
DLQ_NAME=document-events-dlq

# ---- Retry ----
RETRY_MAX=5
RETRY_BACKOFF=5s

# ---- Límites ----
MAX_TEXT_BYTES=52428800

# ---- Logging ----
LOG_LEVEL=info