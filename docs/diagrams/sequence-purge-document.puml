@startuml
!theme plain
autonumber

title "Borrado físico (purge) — POST /api/v1/documents/{document_id}/purge"

actor "Orquestador" as ORQ
participant "Gin Router\n(persister:8083)" as ROUTER
participant "DocumentHandler" as HANDLER
participant "DocumentService" as SERVICE
participant "DocumentRepository\n(mongo)" as REPO
participant "MongoDB" as MONGO

ORQ -> ROUTER : **POST** http://persister:8083\n/api/v1/documents/{document_id}/purge
ROUTER -> HANDLER : Purge()

HANDLER -> SERVICE : Purge(document_id)
SERVICE -> REPO : Purge(document_id)
REPO -> MONGO : deleteOne( documents,\n{ document_id } )
alt documento inexistente
    MONGO --> REPO : 0 eliminados
    REPO --> SERVICE : ErrNotFound
    SERVICE --> HANDLER : ErrNotFound
    HANDLER --> ORQ : **404 Not Found**
else purgado
    MONGO --> REPO : 1 eliminado
    REPO --> SERVICE : ok
    SERVICE --> HANDLER : ok
    HANDLER --> ORQ : **204 No Content**
end

note over MONGO
    El documento desaparece por completo:
    no hay restore posible. Al no existir,
    su checksum queda libre para re-ingesta
    (mismo contenido, nuevo document_id).
    Aplica tanto a docs activos como a
    soft-deleted (purga los lógicos).
end note
@enduml