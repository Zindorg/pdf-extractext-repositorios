@startuml
' Estado actual (2026-10-07): implementado — internal/adapters/health.Pinger
' (ping secuencial: Mongo y después Redis; cualquier fallo → 503).
!theme plain
autonumber

title "Health check — GET /api/v1/health"

actor "Orquestador" as CLI
participant "Gin Router\n(persister:8083)" as ROUTER
participant "DocumentHandler" as HANDLER
participant "health.Pinger" as PINGER
participant "MongoDB" as MONGO
participant "Redis\nStreams" as REDIS

CLI -> ROUTER : **GET** http://persister:8083\n/api/v1/health
ROUTER -> HANDLER : Health()

HANDLER -> PINGER : Ping()
PINGER -> MONGO : ping()
alt Mongo responde ok
    MONGO --> PINGER : ok
    PINGER -> REDIS : ping()
    alt Redis responde ok
        REDIS --> PINGER : ok
        PINGER --> HANDLER : nil
        HANDLER --> CLI : **200 OK** {status:"ok"}
    else Redis caído
        REDIS --> PINGER : error
        PINGER --> HANDLER : error
        HANDLER --> CLI : **503 Service Unavailable**
    end
else Mongo caído
    MONGO --> PINGER : error
    PINGER --> HANDLER : error
    HANDLER --> CLI : **503 Service Unavailable**
end

@enduml